<UserControl x:Class="IPsecSecurityAnalyzer.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:IPsecSecurityAnalyzer.Utilities.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:InverseBooleanConverter x:Key="InvBoolConv" />
        <conv:SeverityToBrushConverter x:Key="SevToBrushConv" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Security Findings" Style="{StaticResource TitleHeaderStyle}" />
                <TextBlock Text="Discovered cryptographic weaknesses, insecure negotiation flags, and configuration non-compliances." Style="{StaticResource SubtitleHeaderStyle}" />
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Empty State (when Findings.Count == 0) -->
            <Border Style="{StaticResource SocCardBorderStyle}" Padding="40" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisConv}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                    <Border Background="#1E293B" CornerRadius="36" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="{StaticResource IconFindings}" Fill="{StaticResource BrushWarning}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No findings available." FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Load and analyze an IPsec PCAP file to detect cryptographic vulnerabilities, expired SAs, weak DH groups, and handshake flaws." 
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="20" />
                </StackPanel>
            </Border>

            <!-- Findings DataGrid (ready for real data) -->
            <DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"
                      Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisConv}}"
                      MinRowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                    <DataGridTemplateColumn Header="Severity" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" Background="{Binding Severity, Converter={StaticResource SevToBrushConv}}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding FormattedSeverity}" Foreground="#0F172A" FontWeight="Bold" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Risk Contribution" Binding="{Binding FormattedRiskContribution}" Width="130" />
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="200" />
                    <DataGridTextColumn Header="Confidence" Binding="{Binding FormattedConfidence}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
