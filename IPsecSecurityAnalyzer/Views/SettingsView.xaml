<UserControl x:Class="IPsecSecurityAnalyzer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Title Section -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource TitleHeaderStyle}" />
                    <TextBlock Text="System environment paths, engine configurations, compliance rules, and theme preferences." Style="{StaticResource SubtitleHeaderStyle}" />
                </StackPanel>
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveSettingsCommand}" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Save Settings" />
                </Button>
            </Grid>

            <!-- Status Notice (if saved) -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />

            <!-- Section 1: System Status & Diagnostic Overview -->
            <Border Style="{StaticResource SocCardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="System Status &amp; Subsystems" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Application Version -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application Version:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" Margin="0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Settings.ApplicationVersion}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13" Margin="0,6" />

                        <!-- Analyzer Status -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Analyzer Status:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Settings.AnalyzerStatus}" Foreground="{StaticResource BrushAccentCyan}" FontSize="13" Margin="0,6" />

                        <!-- AI Engine Status -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="AI Engine Status:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" Margin="0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Settings.AiEngineStatus}" Foreground="{StaticResource BrushWarning}" FontSize="13" Margin="0,6" />

                        <!-- Database Status -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Database Status:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" Margin="0,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Settings.DatabaseStatus}" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: General & Theme Settings -->
            <Border Style="{StaticResource SocCardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="General &amp; Appearance" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme Preset:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,6" />
                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding Settings.Theme}" SelectedValuePath="Content"
                                  Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}" Height="34" Width="240" HorizontalAlignment="Left" Margin="0,6">
                            <ComboBoxItem Content="Dark SOC (Cybersecurity)" IsSelected="True" />
                            <ComboBoxItem Content="High Contrast Midnight" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: Analyzer Paths -->
            <Border Style="{StaticResource SocCardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Analyzer Engine Paths" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,8" />
                    <TextBlock Text="Configure local paths for TShark and Python runtimes used in deep packet dissection." Style="{StaticResource CardSubtitleStyle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="TShark Executable Path:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.TsharkPath, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}" 
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Height="34" Padding="8,6" Margin="0,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Python Environment Path:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.PythonPath, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}" 
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Height="34" Padding="8,6" Margin="0,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 4: AI & Security Rules Configuration -->
            <Border Style="{StaticResource SocCardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="AI Models &amp; Database Settings" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,8" />
                    <TextBlock Text="Configure machine learning weights and SQLite persistence storage." Style="{StaticResource CardSubtitleStyle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="AI Model Weights Path:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.ModelPath, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}" 
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Height="34" Padding="8,6" Margin="0,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SQLite Database Path:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.DatabasePath, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}" 
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Height="34" Padding="8,6" Margin="0,6" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
