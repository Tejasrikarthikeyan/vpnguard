<UserControl x:Class="IPsecSecurityAnalyzer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:IPsecSecurityAnalyzer.Utilities.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Welcome / Banner Card -->
            <Border Style="{StaticResource SocCardBorderStyle}" Margin="0,0,0,20" Background="#111B2E" BorderBrush="{StaticResource BrushAccentCyan}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="IPsec Security Analyzer" Style="{StaticResource TitleHeaderStyle}" Foreground="{StaticResource BrushAccentCyan}" />
                        <TextBlock Text="AI-Powered IPsec VPN Protocol Analysis &amp; Security Assessment" Style="{StaticResource SubtitleHeaderStyle}" FontSize="14" />
                        <TextBlock Text="Automated deep packet inspection framework for IKEv1/v2 handshakes, ESP tunnels, weak cryptographic primitives, and threat posture evaluation." 
                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" />
                    </StackPanel>
                    <Path Grid.Column="1" Data="{StaticResource IconShieldLock}" Fill="{StaticResource BrushAccentCyan}" Width="48" Height="48" Stretch="Uniform" Opacity="0.8" VerticalAlignment="Center" Margin="20,0,0,0" />
                </Grid>
            </Border>

            <!-- Error Banner (if any) -->
            <Border Background="#2A1215" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConv}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconFindings}" Fill="{StaticResource BrushDanger}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" VerticalAlignment="Center" FontWeight="Medium" />
                </StackPanel>
            </Border>

            <!-- Top Executive Summary Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: PCAP Analysis -->
                <Border Grid.Column="0" Style="{StaticResource SocCardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="PCAP Analysis" Style="{StaticResource CardHeaderStyle}" />
                            <Path Data="{StaticResource IconPcap}" Fill="{StaticResource BrushAccentCyan}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedFile.FileName, FallbackValue='No analysis available'}" 
                                   Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding SelectedFile.FormattedFileSize, FallbackValue='Awaiting capture file'}" 
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Card 2: IPsec Sessions -->
                <Border Grid.Column="1" Style="{StaticResource SocCardBorderStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="IPsec Sessions" Style="{StaticResource CardHeaderStyle}" />
                            <Path Data="{StaticResource IconIpsec}" Fill="{StaticResource BrushAccentBlue}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Awaiting analysis" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                        <TextBlock Text="0 Active Handshakes" Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Security Findings -->
                <Border Grid.Column="2" Style="{StaticResource SocCardBorderStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Security Findings" Style="{StaticResource CardHeaderStyle}" />
                            <Path Data="{StaticResource IconFindings}" Fill="{StaticResource BrushWarning}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="No findings available" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                        <TextBlock Text="Vulnerability scan pending" Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Security Score -->
                <Border Grid.Column="3" Style="{StaticResource SocCardBorderStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Security Score" Style="{StaticResource CardHeaderStyle}" />
                            <Path Data="{StaticResource IconSecurityAssessment}" Fill="{StaticResource BrushSuccess}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Awaiting analysis" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                        <TextBlock Text="No security assessment yet" Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Interactive Section: Start an Analysis (Empty State) -->
            <Border Style="{StaticResource SocCardBorderStyle}" Padding="32" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center" MaxWidth="600">
                    <Border Background="#1E293B" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccentCyan}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Start an Analysis" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Select a PCAP file to begin IPsec traffic analysis." FontSize="14" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,20" TextAlignment="Center" />

                    <!-- File Details when selected -->
                    <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20"
                            Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVisConv}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="File Name:" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayFileName}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="File Path:" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayFilePath}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="File Size:" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayFileSize}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" Margin="0,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Extension:" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayExtension}" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" FontWeight="SemiBold" Margin="0,2" />
                        </Grid>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SelectPcapCommand}" Width="160" Height="38">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="#090D16" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Select PCAP" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NavigateToPcapPageCommand}" Width="160" Height="38" Margin="16,0,0,0">
                            <TextBlock Text="View PCAP Page" />
                        </Button>
                    </StackPanel>

                    <!-- Supported Formats Notice -->
                    <TextBlock Text="Supported capture extensions: .pcap, .pcapng (Wireshark / tcpdump captures)" 
                               Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
